# ----------------------
# SERVER
# ----------------------
PORT=3000
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/alupvc
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Dominios del frontend permitidos (separados por comas). Vacío = cualquiera
CORS_ORIGIN=https://alupvcbarcelona.es,https://www.alupvcbarcelona.es
SITE_URL=https://alupvcbarcelona.es
# Solo para crear el primer administrador si la base de datos no tiene usuarios
ALLOW_BOOTSTRAP_ADMIN=false

# ----------------------
# GOOGLE (GMAIL + CALENDAR)
# El refresh token debe tener los scopes:
#   https://mail.google.com/
#   https://www.googleapis.com/auth/calendar
# ----------------------
EMAIL_HOST=alupvcbarcelona@gmail.com
OAUTH_CLIENTID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Email que recibe los avisos del formulario de contacto (por defecto el de la empresa)
ADMIN_EMAIL=

# ----------------------
# CLOUDINARY (fotos de trabajos)
# ----------------------
CLOUDINARY_CLOUD_NAME=bunzti4y
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
